# ========================
# AI PROVIDERS (choose one or more)
# ========================
# Set the provider flag to True to enable it; supply the matching API key below.

# Gemini (Google Generative Models)
USE_GEMINI=False
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Inference API
USE_HUGGINGFACE=False
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# OpenRouter (alternative cloud provider)
USE_OPENROUTER=False
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat

# Local LLM fallback (Ollama or other local server)
USE_LOCAL_LLM=False
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL_NAME=llama2

# ========================
# DATABASE
# ========================
# For local testing the SQLite DB will live next to the backend folder.
DATABASE_URL=sqlite:///./smart_health.db
DATABASE_ECHO=False

# ========================
# SERVER CONFIG
# ========================
ENV=development
DEBUG=True
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ========================
# SECURITY
# ========================
# Replace with a strong random string in production (do not commit real secrets).
SECRET_KEY=replace-with-strong-random-string

# ========================
# LOGGING
# ========================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========================
# CORS (optional override)
# ========================
# Comma-separated list, e.g. "http://localhost:3000,http://localhost:5173"
# Leave empty to use defaults in config.py
ALLOWED_ORIGINS=

# ========================
# SESSION / BEHAVIOUR TUNING
# ========================
# Session expiry in minutes for auto-expiring inactive chat sessions
SESSION_EXPIRY_MINUTES=30

# ========================
# NOTES
# ========================
# 1) Copy this file to .env (backend/.env) and put your real API keys there.
# 2) Add backend/.env to .gitignore to avoid leaking secrets.
# 3) If any keys were accidentally pushed to a remote repo, rotate them immediately.